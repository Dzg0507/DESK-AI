<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Kept out of Google's cloud backup (2026-10-27, docs/AUDIT_2026-10-27.md S5): the database
     (the agent's access token, the chat history) and the Vault's prefs. Same list as data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="database" path="desk_ai_database" />
    <exclude domain="database" path="desk_ai_database-wal" />
    <exclude domain="database" path="desk_ai_database-shm" />
    <exclude domain="sharedpref" path="desk_ai_credentials.xml" />
</full-backup-content>
